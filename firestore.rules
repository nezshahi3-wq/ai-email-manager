rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validPreferences(data, userId) {
      return data.keys().hasOnly(['userId', 'priorityKeywords', 'blockedContacts', 'customMemory', 'updatedAt'])
        && data.userId == userId
        && data.priorityKeywords is list && data.priorityKeywords.size() <= 100
        && data.blockedContacts is list && data.blockedContacts.size() <= 200
        && data.customMemory is string && data.customMemory.size() <= 4000
        && data.updatedAt == request.time;
    }

    // تفضيلات المساعد: كل مستخدم يقرأ ويكتب مستنده فقط
    match /preferences/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && validPreferences(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }

    // أي مسار آخر مرفوض
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
